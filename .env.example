# Stemmy CLI - Environment variables
# Copy to .env and fill in your values

# --- Database (required for most commands) ---
# Local SQLite: path to stemmy.db
STEMMY_DB_PATH=data/stemmy.db

# Turso cloud (optional): enables sync and remote access
# Get credentials: turso db show <db> && turso db tokens create <db>
# https://docs.turso.tech/sdk/python/quickstart
# TURSO_DB_URL=libsql://your-db-name-your-org.turso.io
# TURSO_API_KEY=your-turso-auth-token
# (or TURSO_DATABASE_URL / TURSO_AUTH_TOKEN per Turso docs)

# --- AI / Embeddings (optional) ---
# For embeddings, chat, and agent features
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# --- Standalone: S3 upload (optional) ---
# For direct RSS→compilation without surrounded Flask server
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=eu-north-1
# S3_BUCKET_NAME=voxpop

# --- Standalone: AssemblyAI transcription (optional) ---
# For direct transcription without surrounded
# ASSEMBLY_API_KEY=...

# --- Optional ---
# STEMMY_API_URL=http://localhost:5000
# STEMMY_OUTPUT_FORMAT=table
# STEMMY_VERBOSE=false
# PIXABAY_API_KEY=...  # For music search (Pixabay has no public Music API)
