    "tier": "holdout",
    "format_id": "628b7fb7-87fd-40c2-91bb-6e1d2efd7a0c",
    "duration": 6.105
  },
  {
    "id": "07f5acfa-d8f3-4024-9e61-ca6b6241d19a",
    "item_id": "797e1fa2-2da2-420c-bc58-08ca38c6846f",
    "text": "In many cases, quite close.",
    "start_time": 337.657,
    "end_time": 339.825,
    "audio_url": "https://voxpop.s3.eu-north-1.amazonaws.com/audio/formats/65cef4bc-323d-468b-8b1a-e03cb95f340f/JYI1srodjeg.mp3",
