    "item_id": "86e57d68-aed2-4c97-aa9d-6ee131166991",
    "text": "Ja, dat is sowieso wel iets wat ik merk.",
    "start_time": 943.66,
    "end_time": 946.8,
    "audio_url": "https://voxpop.s3.eu-north-1.amazonaws.com/audio/formats/ervaring-voor-beginners-shared/86e57d68-aed2-4c97-aa9d-6ee131166991.mp3",
