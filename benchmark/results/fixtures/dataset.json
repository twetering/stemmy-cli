    "format_id": "ervaring-voor-beginners-shared",
    "duration": 5.62
  },
  {
    "id": "cdc148d1-bb0b-4d22-b59d-518010803b98",
    "item_id": "0e3cbf29-fdd5-4876-850c-41d30551515d",
    "text": "Ik denk dat dat, ja, dat was een beetje nep eigenlijk, denk ik, achteraf gezien.",
    "start_time": 977.74,
    "end_time": 983.28,
    "audio_url": "https://voxpop.s3.eu-north-1.amazonaws.com/audio/formats/ervaring-voor-beginners-shared/0e3cbf29-fdd5-4876-850c-41d30551515d.mp3",
