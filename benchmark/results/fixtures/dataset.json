    "item_id": "33e366a8-429b-4055-bd05-1007425b8d4a",
    "text": "is ook dat je daar, dat de vorm ook echt is of zo, maar dat is onzin of zo.",
    "start_time": 903.52,
    "end_time": 909.96,
    "audio_url": "https://voxpop.s3.eu-north-1.amazonaws.com/audio/formats/ervaring-voor-beginners-shared/33e366a8-429b-4055-bd05-1007425b8d4a.mp3",
