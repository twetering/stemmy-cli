    "format_id": "4fbf7847-015b-42c6-8985-e50377b8a19e",
    "duration": 3.962
  },
  {
    "id": "3261b53b-693d-4ba1-b164-b7fe296d34de",
    "item_id": "e95db4c6-64a5-4a7e-93d8-58e17140a480",
    "text": "En vandaag is dus mijn eerste dag voor mijn gevoel van mijn volgende leven.",
    "start_time": 78.76,
    "end_time": 83.66,
