    "item_id": "4e752c0e-b1a4-42a0-b924-781be0b69b7a",
    "text": "En ja, daar hekelden we dus.",
    "start_time": 941.659,
    "end_time": 944.84,
    "audio_url": "https://voxpop.s3.eu-north-1.amazonaws.com/audio/formats/ervaring-voor-beginners-shared/4e752c0e-b1a4-42a0-b924-781be0b69b7a.mp3",
