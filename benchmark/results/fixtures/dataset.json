  },
  {
    "id": "92380b6f-2bd3-4a65-898d-d04fab83609c",
    "item_id": "15456847-c1b8-4fa5-bc16-665e6942077a",
    "text": "Laten we even nog een iets concreter voorbeeld, anders worden te technisch.",
    "start_time": 911.02,
    "end_time": 914.58,
    "audio_url": "https://voxpop.s3.eu-north-1.amazonaws.com/audio/formats/ervaring-voor-beginners-shared/15456847-c1b8-4fa5-bc16-665e6942077a.mp3",
