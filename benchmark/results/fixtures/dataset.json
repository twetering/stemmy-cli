    "item_id": "8c01b7c8-833a-414e-918f-326f044e9551",
    "text": "Even Independeren, want daar word je altijd wijzer van.",
    "start_time": 818.77,
    "end_time": 822.732,
    "audio_url": "https://voxpop.s3.eu-north-1.amazonaws.com/audio/trimmed/trimmed_9fadcbea-a4ac-4420-ba86-88a6156eb945.mp3",
