    "item_id": "84b4a3ac-42c1-4e72-90d8-265a2594ecea",
    "text": "lieve luisteraars van hart welkom bij een nieuwe aflevering van ervaring voor beginners ik heb een",
    "start_time": 1.879,
    "end_time": 7.54,
    "audio_url": "https://voxpop.s3.eu-north-1.amazonaws.com/audio/formats/ervaring-voor-beginners-shared/84b4a3ac-42c1-4e72-90d8-265a2594ecea.mp3",
