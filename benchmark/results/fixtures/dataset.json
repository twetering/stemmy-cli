  },
  {
    "id": "c8075eef-6bce-4f49-8e0f-906847b073d9",
    "item_id": "be0b53a9-0390-4731-b82b-d53d250d8175",
    "text": "Ja, dat idee van het komt altijd goed, dat stemmetje haal ik altijd pas tevoorschijn om half tien als ik nog maar tweehonderd woorden heb.",
    "start_time": 672.04,
    "end_time": 678.58,
