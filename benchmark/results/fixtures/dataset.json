    "item_id": "f2509fbe-62d0-43a1-9410-ec7a7ace3a47",
    "text": "Of is het, is het, wat behelst dat precies, die literaire non -fictie?",
    "start_time": 85.42,
    "end_time": 89.62,
    "audio_url": "https://voxpop.s3.eu-north-1.amazonaws.com/audio/formats/ervaring-voor-beginners-shared/f2509fbe-62d0-43a1-9410-ec7a7ace3a47.mp3",
